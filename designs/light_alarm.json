  "meta": {
    "name": "光闹钟 / wake-up light alarm",
    "version": 1,
    "description": "预设时间到点后 LED 灯组亮起，亮度随时间单调上升，第 5 分钟达到最大并同时播放音乐闹铃。",
    "author": "apogee",
    "status": "design-draft"
  },

