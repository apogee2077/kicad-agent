{
  "meta": {
    "name": "光闹钟 / wake-up light alarm",
    "version": 1,
    "description": "预设时间到点后 LED 灯组亮起，亮度随时间单调上升，第 5 分钟达到最大并同时播放音乐闹铃。",
    "author": "apogee",
    "status": "design-draft"
  },
  "params": {
    "ramp_seconds": 300,
    "audio_start": "at_peak",
    "audio_start_comment": "at_peak=第5分钟才响；at_start=到点立刻响。需求原文可两解，此参数留出切换余地。",
    "led_count": 8,
    "led_current_ma": 23,
    "pwm_frequency_hz": 5000,
    "pwm_resolution_bits": 12,
    "brightness_curve": "gamma",
    "gamma": 2.2,
    "update_rate_hz": 50,
    "time_source": "ds3231m_i2c_alarm",
    "supply_voltage_v": 5.0,
    "led_vf_v": 3.0
  },
